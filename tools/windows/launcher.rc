            VALUE "OriginalFilename", "Journey.exe"
            VALUE "ProductName", "Journey"
            VALUE "ProductVersion", "1.0 RC1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
